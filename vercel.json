{
  "version": 2,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "build": {
    "env": {
      "VITE_PAYSTACK_CURRENCY": "KES",
      "VITE_PAYSTACK_COUNTRY": "KE"
    }
  }
}
